    {
      "name": "Produtos",
      "item": [
        {
          "name": "T03 - Criar produto (Gerente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const criado = pm.response.json();",
                  "",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"base_url\") + \"/produtos\",",
                  "    method: \"GET\",",
                  "    header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"gerente_token\") }",
                  "}, function (err, res) {",
                  "    if (!err && res.code === 200) {",
                  "        const produtos = res.json();",
                  "        const encontrado = produtos.slice().reverse().find(function (p) {",
                  "            return p.nome === criado.nome && p.preco === criado.preco;",
                  "        });",
                  "        if (encontrado) {",
                  "            pm.collectionVariables.set(\"produto_id\", encontrado.id);",
                  "        }",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{gerente_token}}", "type": "string" } ] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Tapioca Postman\",\n  \"preco\": 12.5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/produtos", "host": [ "{{base_url}}" ], "path": [ "produtos" ] }
          },
          "response": []
        }
      ]
    },
